{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": { "@/*": ["./*"], "@messages/*": ["../../messages/*"] },
    "allowJs": false,
    "incremental": true
